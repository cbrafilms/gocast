RewriteEngine On

# Permite /api/register, /api/login, /api/verify-token sin .php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^register/?$ register.php [L,QSA]
RewriteRule ^login/?$ login.php [L,QSA]
RewriteRule ^verify-token/?$ verify-token.php [L,QSA]
RewriteRule ^upload-media/?$ upload-media.php [L,QSA]
RewriteRule ^perfil-talento/?$ perfil-talento.php [L,QSA]
RewriteRule ^castings/?$ castings.php [L,QSA]
RewriteRule ^mis-castings/?$ mis-castings.php [L,QSA]
RewriteRule ^buscar-talentos/?$ buscar-talentos.php [L,QSA]
RewriteRule ^aplicaciones-recibidas/?$ aplicaciones-recibidas.php [L,QSA]
RewriteRule ^castings-recomendados/?$ castings-recomendados.php [L,QSA]
RewriteRule ^auto-match/?$ auto-match.php [L,QSA]
RewriteRule ^talentos/([0-9]+)/perfil/?$ talento-perfil.php?user_id=$1 [L,QSA]
RewriteRule ^castings/([0-9]+)/?$ casting-detalle.php?id=$1 [L,QSA]
RewriteRule ^aplicaciones/?$ aplicaciones.php [L,QSA]
RewriteRule ^mis-aplicaciones/?$ aplicaciones.php [L,QSA]
RewriteRule ^aplicaciones/([0-9]+)/preseleccionar/?$ aplicacion-preseleccionar.php?id=$1 [L,QSA]
RewriteRule ^castings/([0-9]+)/preseleccionados/?$ castings-preseleccionados.php?id=$1 [L,QSA]
RewriteRule ^shortlists/?$ shortlists.php [L,QSA]
RewriteRule ^castings/([0-9]+)/shortlists/?$ shortlists.php?casting_id=$1 [L,QSA]

# Opciones de seguridad
Options -Indexes
